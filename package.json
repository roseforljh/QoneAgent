{
  "name": "qone-agent",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-telemetry": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@earendil-works/pi-mcp": "1.5.2",
    "@earendil-works/pi-codemode": "1.5.2"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:runtime": "bun run --cwd apps/agent-runtime dev",
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "build": "bun run --cwd apps/desktop build",
    "build:release": "bun run --cwd apps/desktop build:release",
    "typecheck": "bun run --cwd apps/agent-runtime typecheck && bun run --cwd apps/desktop build",
    "test": "bun test apps/agent-runtime/test",
    "test:smoke": "bun run apps/agent-runtime/test/smoke.ts"
  },
  "devDependencies": {
    "bun-types": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "patchedDependencies": {
    "@earendil-works/pi-coding-agent@1.5.2": "patches/@earendil-works%2Fpi-coding-agent@1.5.2.patch",
    "@assistant-ui/react@0.15.36": "patches/@assistant-ui%2Freact@0.15.36.patch",
    "@assistant-ui/react-lexical@0.2.23": "patches/@assistant-ui%2Freact-lexical@0.2.23.patch",
    "@assistant-ui/core@0.3.36": "patches/@assistant-ui%2Fcore@0.3.36.patch",
    "node-pty@1.2.0-beta.18": "patches/node-pty@1.2.0-beta.18.patch",
    "@xterm/xterm@6.0.0": "patches/@xterm%2Fxterm@6.0.0.patch"
  }
}
