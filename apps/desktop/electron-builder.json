{
  "appId": "com.qone.agent",
  "productName": "QoneAgent",
  "publish": null,
  "electronLanguages": ["zh-CN", "zh-TW", "en-US"],
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "resources/**/*",
    "package.json"
  ],
  "asarUnpack": [
    "node_modules/node-pty/**"
  ],
  "extraResources": [
    {
      "from": "binaries",
      "to": "binaries",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "resources/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "QoneAgent",
    "deleteAppDataOnUninstall": false
  }
}
