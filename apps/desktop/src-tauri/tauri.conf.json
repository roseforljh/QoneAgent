{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qone",
  "version": "0.0.1",
  "identifier": "com.qone.agent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run build:browser && bun run dev",
    "beforeBuildCommand": "bun run build:release"
  },
  "app": {
    "windows": [
      {
        "title": "Qone",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:"
      },
      "devCsp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/qone-runtime", "binaries/qone-browser-node"],
    "resources": ["binaries/qone-browser-helper.mjs"]
  }
}
